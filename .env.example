# Copier en .env et renseigner. .env n'est jamais versionné.

# Projet Supabase
SUPABASE_URL=https://votre-projet.supabase.co

# Clé « anon » : publiée dans le navigateur, protégée par RLS.
SUPABASE_ANON_KEY=

# Clé de service : accès total, contourne RLS.
# Uniquement pour scripts/import-leads.mjs, jamais dans le front,
# jamais dans une variable d'environnement exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
